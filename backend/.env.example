SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to fall back to local SQLite for development.
# DATABASE_URL=postgres://user:password@host:5432/dbname

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Leave unset to print emails to the console instead of sending for real.
# BREVO_SMTP_LOGIN=your-brevo-smtp-login
# BREVO_SMTP_KEY=your-brevo-smtp-key
DEFAULT_FROM_EMAIL=ZardoCards <info@zardocards.com>
ADMIN_NOTIFICATION_EMAIL=info@zardocards.com

# Leave unset to store uploaded images on local disk instead of MinIO.
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=zardocards
# MINIO_SECRET_KEY=changeme123!
# MINIO_BUCKET_NAME=zardocards
# MINIO_USE_SSL=False
# MINIO_PUBLIC_URL=http://localhost:9000/zardocards
